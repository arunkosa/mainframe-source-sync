# =============================================================================
# sync.env.template
# Reference template for the environment configuration used by
# bin/sync_mainframe_source.sh. This file is tracked in git and holds
# no secrets, but its values (paths, retention, etc.) are environment-
# specific, so it should NOT be edited in place and used directly in
# production. Instead, copy it to an external, untracked location (outside
# this repo, so a future `git pull` of this repo never touches it) and
# point PROJECT_CONFIG at that copy in config/app_config.txt. Precedence
# at runtime (highest wins): -c flag > $PROJECT_CONFIG env var > this
# template (fallback, for local testing only).
# =============================================================================

# --- Source / target paths (steps 1-2 of the manual process) ---------------
# Where exported source libraries are written by your upstream process
SOURCE_BASE_DIR="/path/to/exported-source"

# Local clone of the target Git repository (git operations run here)
TARGET_BASE_DIR="/path/to/target-repository"

# --- Git settings (step 3 of the manual process) ----------------------------
GIT_REMOTE="origin"
GIT_BRANCH="main"
GIT_COMMIT_MESSAGE_PREFIX="Automated sync"

# Full path to the Git client used by this script. This must be set explicitly
# in the active sync.env; do not rely on PATH under JCL/BPXBATCH.
GIT_BIN="/sw/mincnda/envs/tools/bin/git"

# Local (repo-level) git identity to use in the target repo, set once if not
# already configured there. Without this, some Git environments auto-derive
# an identity from the OS username and hostname.
GIT_AUTHOR_NAME="Mainframe Source Sync"
GIT_AUTHOR_EMAIL="maintainer@example.com"

# Retry behavior for git push (handles transient network failures)
GIT_PUSH_RETRY_COUNT=3
GIT_PUSH_RETRY_DELAY_SECONDS=10

# Optional deep diagnostics for git push failures. When enabled, push output
# (including git trace signals) is written to GIT_PUSH_TRACE_LOG.
GIT_PUSH_TRACE_ENABLED=false
GIT_PUSH_TRACE_LOG="/tmp/git_push_trace.log"

# Full path to the SSH client used by Git for push operations. This is
# required explicitly under JCL/BPXBATCH where ssh may not be on PATH.
SSH_BIN="/bin/ssh"

# --- Logging -----------------------------------------------------------------
LOG_DIR="/tmp/mainframe-source-sync/logs"
LOG_RETENTION_DAYS=30
DEBUG=false
