# =============================================================================
# .gitattributes
# Bootstrapped automatically into the target source-mirror repo by
# ensure_target_bootstrap_files() (lib/git_ops.sh) on first sync run, before
# any exported source files are added. Enforces LF line endings and
# Rocket Git for z/OS working-tree encoding rules so tagged EBCDIC files can
# be added without the "file is tagged, set corresponding
# zos-working-tree-encoding attribute" error.
# =============================================================================
* text=auto eol=lf

# file encodings for Rocket Git for Z version 2.43 and higher
*.cbl zos-working-tree-encoding=IBM-1047
*.spcbl zos-working-tree-encoding=IBM-1047
*.cob zos-working-tree-encoding=IBM-1047
*.cobol zos-working-tree-encoding=IBM-1047
